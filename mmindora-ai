<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MINDORA AI</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="app-container">
        <div class="welcome-screen" id="welcomeScreen">
            <div class="logo-container">
                <div class="logo-icon"><i class="fa-solid fa-network-wired"></i></div>
                <h1 class="logo-title">MINDORA AI</h1>
            </div>
        </div>

        <div class="chat-messages" id="chatMessages"></div>

        <div class="image-preview-container" id="imagePreviewContainer" style="display: none;">
            <img id="imagePreview" src="" alt="المعاينة">
            <button id="removeImageBtn"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="input-section">
            <div class="search-bar-box">
                <label for="imageUpload" class="action-icon-btn" title="رفع صورة">
                    <i class="fa-solid fa-image"></i>
                </label>
                <input type="file" id="imageUpload" accept="image/*" style="display: none;">
                
                <textarea id="userInput" placeholder="أسأل MINDORA AI..." rows="1"></textarea>
                
                <button id="sendBtn" class="action-icon-btn send-active" title="إرسال">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>
    </div>
    <script src="script.js"></script>
</body>
</html>
